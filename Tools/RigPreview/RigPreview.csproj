<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Rig preview: runs the game's RigSolver (Runtime/Archers/Rig*.cs) outside Unity and prints solved poses as JSON;
    Tools/art/preview_rig.py composes the exported sprites with them into a PNG (checks the C# port against the design).
      dotnet run -\-project Tools/RigPreview > /tmp/poses.json
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityRef Condition="'$(UnityRef)' == ''">/opt/unityref</UnityRef>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/ArcherArcade/Runtime/Archers/Rig*.cs" />
    <Reference Include="$(UnityRef)/Editor/Data/Managed/UnityEngine/UnityEngine.CoreModule.dll"><Private>true</Private></Reference>
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles Assets/ArcherArcade/Logic exactly like Unity does (netstandard2.1, C# 9, no UnityEngine),
       so the pure-C# game rules can be built and tested on any machine without Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ArcherArcade.Logic</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/ArcherArcade/Logic/**/*.cs" />
  </ItemGroup>
</Project>
